# Set to live after you enter the sponsor credentials and before you seed the demo.
TORQUE_MODE=mock

ARCEE_API_KEY=
ARCEE_MODEL=trinity-mini

COGNEE_API_KEY=
# Copy the API base URL from Connect → API Keys in your Cognee Cloud workspace.
COGNEE_BASE_URL=
COGNEE_DATASET=torque-pump-demo

SINGLESTORE_HOST=
SINGLESTORE_PORT=3306
SINGLESTORE_DATABASE=
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
# Absolute path to the SingleStore CA bundle if your cluster needs a custom CA.
SINGLESTORE_CA_PATH=
